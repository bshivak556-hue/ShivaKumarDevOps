pipeline {
    agent any
    options { timestamps() }
    stages {
        stage('Check Java') {
            steps {
                dir('Exp5-Jenkins-CI') {
                    bat 'java -version'
                    bat 'javac -version'
                }
            }
        }
        stage('Compile') {
            steps {
                dir('Exp5-Jenkins-CI') {
                    bat 'if not exist build mkdir build'
                    bat 'javac -d build HelloDevOps.java'
                }
            }
        }
        stage('Run and Test') {
            steps {
                dir('Exp5-Jenkins-CI') {
                    bat 'java -cp build HelloDevOps'
                    bat 'java -ea -cp build HelloDevOps --test'
                }
            }
        }
    }
    post {
        success { echo 'CI pipeline completed successfully.' }
        failure { echo 'CI pipeline failed. Check Console Output.' }
    }
}
